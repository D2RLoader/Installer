# Settings for publish-release.cmd and publish-installer.cmd.
# Copy this file to publish.env (publish.env is not committed) and change the values.
#
# Nothing secret goes in this file. The key, the port, and the user come from your SSH configuration.
# The scripts run the programs ssh and scp from your PATH. Test your login first with:  ssh <SSH_TARGET> true
# If your key has a passphrase, load it into the ssh-agent first (ssh-add), or you must type it for each connection.

# A "Host" entry in your ~/.ssh/config (best), or user@host.
SSH_TARGET=d2rloader-web

# The folder on the server that Nginx serves as PUBLIC_URL. An absolute path.
# The scripts put the files in it, and the test files in its "test" folder.
REMOTE_DIR=/srv/www/d2rloader.net-download

# The public address of that folder. It must start with https:// and end with /.
PUBLIC_URL=https://d2rloader.net/download/
